# ResQLink frontend environment variables
# Copy to .env and fill in the real values for your deployment.
# These are consumed at client build time by vite.

# Optional — override the API base URL at runtime.
# Leave empty to use a relative /api (recommended for Same-Origin deployments).
VITE_API_URL=

# Optional — if your deployed frontend is on a different origin than the API.
# VITE_API_URL=https://your-api-domain.example.com
